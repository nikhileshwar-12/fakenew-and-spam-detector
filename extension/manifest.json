{
  "manifest_version": 3,
  "name": "TruthGuard — Fake News & Spam Checker",
  "version": "1.0",
  "description": "Highlight text on any website and instantly check it for fake news and spam using TruthGuard AI.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"] }
  ],
  "action": { "default_popup": "popup.html", "default_title": "TruthGuard" }
}